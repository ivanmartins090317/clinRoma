# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do app (dev local com HTTPS)
NEXT_PUBLIC_APP_URL=https://localhost:3000

# Senha Postgres — só para npm run db:push (Fase 1+)
# SUPABASE_DB_PASSWORD=

# Service role — somente server-side (seed, jobs, resposta pública fila). Nunca no client.
# SUPABASE_SERVICE_ROLE_KEY=

# Cron — expiração de ofertas da fila (header Authorization: Bearer ...)
# CRON_SECRET=

# Hash de IP na resposta pública da fila (server-only)
# WAITLIST_IP_HASH_SECRET=

# OpenAI — transcrição Whisper (server-side only)
# OPENAI_API_KEY=

# Resend — lembrete pós-consulta por e-mail (server-side only)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=ClinRoma <lembretes@seudominio.com.br>

# E-mail do financeiro para aviso de estoque baixo (opcional; vazio = não dispara)
# Em desenvolvimento pode usar ivanmartins.ilha@gmail.com; em produção, o endereço que o Felipe passar.
# FINANCE_ALERT_EMAIL=
